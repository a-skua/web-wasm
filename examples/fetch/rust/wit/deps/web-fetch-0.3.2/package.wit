package web:fetch@0.3.2;

/// Shared types of the Fetch API.
///
/// See <https://developer.mozilla.org/docs/Web/API/Fetch_API>.
interface types {
  /// Exceptions thrown (or Promises rejected) by the Fetch API.
  ///
  /// Each case corresponds to the JavaScript error name and carries its message.
  variant error {
    /// `TypeError`: invalid URL, invalid header, body already used, network error, etc.
    type-error(string),
    /// `RangeError`: e.g. an invalid status passed to `Response()`.
    range-error(string),
    /// `AbortError` (`DOMException`): the request was aborted via its signal.
    abort-error(string),
    /// `TimeoutError` (`DOMException`): aborted by `AbortSignal.timeout()`.
    timeout-error(string),
    /// `NotAllowedError` (`DOMException`): blocked by Permissions Policy.
    not-allowed-error(string),
  }

  /// `Request.method`.
  ///
  /// HTTP methods are case-sensitive tokens, so any other method is `other`.
  variant method {
    get,
    head,
    post,
    put,
    delete,
    connect,
    options,
    trace,
    patch,
    other(string),
  }

  /// `RequestMode`.
  enum request-mode {
    navigate,
    same-origin,
    no-cors,
    cors,
  }

  /// `RequestCredentials`.
  enum request-credentials {
    omit,
    same-origin,
    %include,
  }

  /// `RequestCache`.
  enum request-cache {
    default,
    no-store,
    reload,
    no-cache,
    force-cache,
    only-if-cached,
  }

  /// `RequestRedirect`.
  enum request-redirect {
    follow,
    error,
    manual,
  }

  /// `RequestDuplex`.
  enum request-duplex {
    half,
  }

  /// `RequestPriority`.
  enum request-priority {
    high,
    low,
    auto,
  }

  /// `ReferrerPolicy`.
  ///
  /// The empty string `""` is represented by `none` of `option<referrer-policy>`.
  enum referrer-policy {
    no-referrer,
    no-referrer-when-downgrade,
    same-origin,
    origin,
    strict-origin,
    origin-when-cross-origin,
    strict-origin-when-cross-origin,
    unsafe-url,
  }

  /// `RequestDestination`.
  ///
  /// The empty string `""` is represented by `none` of `option<request-destination>`.
  /// Values unknown to this definition are passed through as `other`.
  variant request-destination {
    audio,
    audioworklet,
    document,
    embed,
    fencedframe,
    font,
    frame,
    iframe,
    image,
    json,
    manifest,
    object,
    paintworklet,
    report,
    script,
    serviceworker,
    sharedworker,
    speculationrules,
    style,
    text,
    track,
    video,
    worker,
    xslt,
    other(string),
  }

  /// `ResponseType`.
  enum response-type {
    basic,
    cors,
    default,
    error,
    opaque,
    opaqueredirect,
  }

  /// `BodyInit`.
  ///
  /// `Blob`, `FormData` and `URLSearchParams` are not supported.
  variant body-init {
    /// `USVString`
    text(string),
    /// `BufferSource` (`ArrayBuffer`, `TypedArray`, `DataView`)
    bytes(list<u8>),
    /// `ReadableStream<Uint8Array>`
    %stream(stream<u8>),
  }
}

/// The `Headers` interface.
///
/// See <https://developer.mozilla.org/docs/Web/API/Headers>.
interface headers {
  use types.{error};

  /// `[name, value]` pair.
  type header = tuple<string, string>;

  /// `Headers`.
  resource headers {
    /// `new Headers(init)`.
    constructor(init: option<headers-init>) -> result<headers, error>;
    /// `Headers.append()`.
    append: func(name: string, value: string) -> result<_, error>;
    /// `Headers.delete()`.
    delete: func(name: string) -> result<_, error>;
    /// `Headers.get()`. Returns `none` for `null`.
    get: func(name: string) -> result<option<string>, error>;
    /// `Headers.getSetCookie()`.
    get-set-cookie: func() -> list<string>;
    /// `Headers.has()`.
    has: func(name: string) -> result<bool, error>;
    /// `Headers.set()`.
    set: func(name: string, value: string) -> result<_, error>;
    /// `Headers.entries()`.
    entries: func() -> list<header>;
    /// `Headers.keys()`.
    keys: func() -> list<string>;
    /// `Headers.values()`.
    values: func() -> list<string>;
  }

  /// `HeadersInit`.
  variant headers-init {
    /// `Headers`
    headers(headers),
    /// `sequence<sequence<ByteString>>` / `record<ByteString, ByteString>`
    entries(list<header>),
  }
}

/// The `Request` interface.
///
/// See <https://developer.mozilla.org/docs/Web/API/Request>.
interface request {
  use types.{error, method, request-mode, request-credentials, request-cache, request-redirect, request-duplex, request-priority, referrer-policy, request-destination, body-init};
  use headers.{headers, headers-init};

  /// `RequestInit`.
  ///
  /// `attributionReporting`, `browsingTopics`, `privateToken` and
  /// `targetAddressSpace` are not supported.
  record request-init {
    method: option<method>,
    headers: option<headers-init>,
    body: option<body-init>,
    referrer: option<string>,
    /// `none` keeps the default. Use `some(none)` for `""`.
    referrer-policy: option<option<referrer-policy>>,
    mode: option<request-mode>,
    credentials: option<request-credentials>,
    cache: option<request-cache>,
    redirect: option<request-redirect>,
    integrity: option<string>,
    keepalive: option<bool>,
    /// `AbortSignal`. The request is aborted when this future resolves.
    signal: option<future>,
    duplex: option<request-duplex>,
    priority: option<request-priority>,
  }

  /// `Request`.
  resource request {
    /// `new Request(input, init)`.
    constructor(input: request-info, init: option<request-init>) -> result<request, error>;
    /// `Request.body`. Returns `none` for `null`.
    body: func() -> option<stream<u8>>;
    /// `Request.bodyUsed`.
    body-used: func() -> bool;
    /// `Request.cache`.
    cache: func() -> request-cache;
    /// `Request.credentials`.
    credentials: func() -> request-credentials;
    /// `Request.destination`. Returns `none` for `""`.
    destination: func() -> option<request-destination>;
    /// `Request.duplex`.
    duplex: func() -> request-duplex;
    /// `Request.headers`.
    headers: func() -> headers;
    /// `Request.integrity`.
    integrity: func() -> string;
    /// `Request.isHistoryNavigation`.
    is-history-navigation: func() -> bool;
    /// `Request.isReloadNavigation`.
    is-reload-navigation: func() -> bool;
    /// `Request.keepalive`.
    keepalive: func() -> bool;
    /// `Request.method`.
    method: func() -> method;
    /// `Request.mode`.
    mode: func() -> request-mode;
    /// `Request.redirect`.
    redirect: func() -> request-redirect;
    /// `Request.referrer`.
    referrer: func() -> string;
    /// `Request.referrerPolicy`. Returns `none` for `""`.
    referrer-policy: func() -> option<referrer-policy>;
    /// `Request.url`.
    url: func() -> string;
    /// `Request.bytes()` (also covers `Request.arrayBuffer()`).
    bytes: async func() -> result<list<u8>, error>;
    /// `Request.text()`.
    text: async func() -> result<string, error>;
    /// `Request.clone()`.
    clone: func() -> result<request, error>;
  }

  /// `RequestInfo` (`Request` or `USVString`).
  variant request-info {
    url(string),
    request(request),
  }
}

/// The `Response` interface.
///
/// See <https://developer.mozilla.org/docs/Web/API/Response>.
interface response {
  use types.{error, response-type, body-init};
  use headers.{headers, headers-init};

  /// `ResponseInit`.
  record response-init {
    status: option<u16>,
    status-text: option<string>,
    headers: option<headers-init>,
  }

  /// `Response`.
  resource response {
    /// `new Response(body, init)`.
    constructor(body: option<body-init>, init: option<response-init>) -> result<response, error>;
    /// `Response.error()`.
    error: static func() -> response;
    /// `Response.redirect()`.
    redirect: static func(url: string, status: option<u16>) -> result<response, error>;
    /// `Response.body`. Returns `none` for `null`.
    body: func() -> option<stream<u8>>;
    /// `Response.bodyUsed`.
    body-used: func() -> bool;
    /// `Response.headers`.
    headers: func() -> headers;
    /// `Response.ok`.
    ok: func() -> bool;
    /// `Response.redirected`.
    redirected: func() -> bool;
    /// `Response.status`.
    status: func() -> u16;
    /// `Response.statusText`.
    status-text: func() -> string;
    /// `Response.type`.
    %type: func() -> response-type;
    /// `Response.url`.
    url: func() -> string;
    /// `Response.bytes()` (also covers `Response.arrayBuffer()`).
    bytes: async func() -> result<list<u8>, error>;
    /// `Response.text()`.
    text: async func() -> result<string, error>;
    /// `Response.clone()`.
    clone: func() -> result<response, error>;
  }
}

/// The `fetch()` function.
///
/// See <https://developer.mozilla.org/docs/Web/API/Window/fetch>.
interface fetch {
  use types.{error};
  use request.{request-info, request-init};
  use response.{response};

  /// `fetch(resource, options)`.
  ///
  /// HTTP error statuses (e.g. 404) are not errors; check `response.ok`.
  fetch: async func(%resource: request-info, options: option<request-init>) -> result<response, error>;
}

world imports {
  export types;
  export headers;
  export request;
  export response;
  export fetch;
}
